# Conference Agent Environment Variables

# Email Notification Settings
# ============================

# Enable or disable email notifications
EMAIL_ENABLED=false

# SMTP Server Configuration
# For Gmail: smtp.gmail.com (port 587 with TLS)
# For Outlook: smtp-mail.outlook.com (port 587 with TLS)
# For Yahoo: smtp.mail.yahoo.com (port 587 with TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Email Credentials
# IMPORTANT: For Gmail, you need to use an "App Password" instead of your regular password
# Generate one at: https://myaccount.google.com/apppasswords
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# Recipient Email
# This is where notifications will be sent
RECIPIENT_EMAIL=recipient@example.com

# Usage:
# 1. Copy this file to .env
# 2. Fill in your email settings
# 3. Run: python main.py --latest 50 --notify
